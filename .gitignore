# dependencias / builds (viven en volúmenes Docker, nunca en la PC)
node_modules/
dist/
.next/
*.tsbuildinfo

# entorno — contiene credenciales reales (.env.example SÍ se versiona)
.env
.env.local
.env.*.local

# secretos nativos / firma de apps — NUNCA subir al repo
google-services.json
GoogleService-Info.plist
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
*.cer
apps/mobile/credentials.json

# logs y temporales
*.log
.DS_Store
Thumbs.db

# override de docker SOLO local (expone puertos/CORS para dev móvil) — NUNCA en prod
docker-compose.override.yml

# Expo / React Native
apps/mobile/.expo/
apps/mobile/web-build/
apps/mobile/dist/

# Respaldos comprimidos sueltos: no van al repositorio (GitHub rechaza >100 MB)
*.rar
*.zip
*.7z
*.bak
