# Reverse proxy con HTTPS automático (Let's Encrypt).
# El dominio y el email vienen del .env (DOMAIN, ACME_EMAIL).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Compresión de TODAS las respuestas (el JSON del panel viajaba crudo:
	# listas de eventos, auditoría y reportes bajan ~85-90% de peso).
	# Caddy respeta lo que ya venga comprimido (assets de Next), no recomprime.
	encode zstd gzip

	# headers de seguridad para todas las respuestas
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# /api/* → API (se quita el prefijo /api antes de pasar a la API)
	handle_path /api/* {
		reverse_proxy api:4000
	}
	# todo lo demás → web Next.js
	handle {
		reverse_proxy web:3000
	}
}
