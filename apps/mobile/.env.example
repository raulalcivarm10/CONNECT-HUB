# App móvil (Expo) — variables EXPO_PUBLIC_* .
# OJO: todo EXPO_PUBLIC_* se compila dentro del binario, así que NO son secretos.
# Para builds de tienda estos valores ya están horneados en eas.json (perfiles
# preview/production); este .env solo se usa al correr localmente (expo start).
# Copia este archivo a .env:  cp .env.example .env

# API pública de ConnectHub y web
EXPO_PUBLIC_API_URL=https://connecthub.fourstacklabs.com/api
EXPO_PUBLIC_WEB_URL=https://connecthub.fourstacklabs.com

# Servicio externo de pagos/identidad (Evento-back) + rutas de auth
EXPO_PUBLIC_PAGOS_API_URL=https://api-ligaprocorp.ec:3443/api
EXPO_PUBLIC_PAGOS_LOGIN_PATH=/auth/login-user-password
EXPO_PUBLIC_PAGOS_GOOGLE_PATH=/auth/register-google
EXPO_PUBLIC_PAGOS_APPLE_PATH=/auth/register-apple
EXPO_PUBLIC_PAGOS_REFRESH_PATH=/auth/refresh

# Google Sign-In (client IDs OAuth — públicos por diseño)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=338617760077-ncr1fcr5sosegoevnjhns4rrskvamjuo.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=338617760077-2kdidcrko33qet7g3rfv1n5gd1jj4dlq.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=338617760077-ma8eeeis1481u486m00q3tovkjv43huu.apps.googleusercontent.com
