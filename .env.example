# Oracle (base remota existente — esquema CONNECT_HUB)
ORACLE_USER=CONNECT_HUB
ORACLE_PASSWORD=changeme
ORACLE_CONNECT_STRING=host:1521/servicio
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=changeme-random-64-chars
JWT_REFRESH_SECRET=changeme-random-64-chars
COOKIE_SECRET=changeme-random-32-chars

# --- Auth de asistentes (app móvil) ---
# Secretos propios de ConnectHub para firmar los tokens de la app de asistentes.
# Genera cada uno con:  openssl rand -hex 32
JWT_ASISTENTE_SECRET=changeme-random-64-chars
JWT_ASISTENTE_REFRESH_SECRET=changeme-random-64-chars

# Servicio externo de pagos/identidad (Evento-back). Su JWT_SECRET firma los
# tokens del login usuario/clave, Google y Apple; PAGOS_JWT_SECRET debe COINCIDIR
# EXACTAMENTE con el JWT_SECRET de Evento-back o el intercambio de sesión falla.
PAGOS_API_URL=https://api-ligaprocorp.ec:3443/api
PAGOS_JWT_SECRET=changeme-debe-coincidir-con-evento-back

# IDs de cliente OAuth aceptados al verificar el id_token (separados por coma).
# Google: los client IDs (web/ios/android) del proyecto de Google Cloud.
GOOGLE_CLIENT_IDS=xxxxx.apps.googleusercontent.com,yyyyy.apps.googleusercontent.com
# Apple: el/los bundle id aceptados como audiencia del token de Sign in with Apple.
APPLE_CLIENT_IDS=com.fourstacklabs.connecthub

# Redis (contenedor interno del compose)
REDIS_URL=redis://redis:6379

# SMTP para correos (recuperación de clave y credenciales de nuevos usuarios).
# Sin SMTP_HOST, la clave se devuelve en la respuesta (solo desarrollo).
# Google Workspace: host smtp.gmail.com, puerto 587, y SMTP_PASS debe ser una
# "App Password" de 16 caracteres (requiere verificación en 2 pasos), NO la
# contraseña normal de la cuenta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ConnectHub <support@fourstacklabs.com>
# URL pública usada en el enlace del correo de credenciales
APP_URL=https://connecthub.fourstacklabs.com

# Webhook de FourStackLabs (provisión de institución al pagar el servicio).
# Secreto compartido con FSL para verificar la firma HMAC (X-FSL-Signature).
# Endpoint: POST https://connecthub.fourstacklabs.com/api/fsl/webhooks
FSL_WEBHOOK_SECRET=

# NAS de archivos (imágenes de eventos/instituciones/locales)
NAS_URL=https://api-ligaprocorp.ec:3443/api

# Producción: proxy HTTPS (Caddy)
DOMAIN=connecthub.tudominio.com
ACME_EMAIL=admin@tudominio.com
COOKIE_SECURE=true

# Web
# En prod detrás del proxy: https://TU_DOMINIO/api
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_NAS_URL=https://api-ligaprocorp.ec:3443/api
